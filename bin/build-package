#!/usr/bin/env bash
#
# Build the sdist and wheel (this replaces `python setup.py sdist`, which setuptools deprecates).
# Version and install_requires come from src/gui/settings.py and requirements.txt respectively.
#
#   bin/build-package
#
# Dev install instead of the tar.gz: uv pip install -e .

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

uv build

echo
echo "Install the built package:  uv pip install dist/pynsource-*.tar.gz"
echo "Install in dev mode:        uv pip install -e ."
echo "Uninstall:                  uv pip uninstall pynsource"
echo
ls -l dist/
