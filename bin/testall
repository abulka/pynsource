# cd src
# bin/testall

mkdir -p src/tests/logs

# Runs the full suite, wx included - most tests build a real wx.App, so this needs a display.
# On a headless box: xvfb-run -a bin/testall   (TRAVIS=1 skips every wx test - legacy escape hatch)

# point this at the venv interpreter if python3 on PATH is not it, e.g.
# PYTHON=/path/to/pynsource/.venv/bin/python
PYTHON=python3

$PYTHON --version
$PYTHON -m unittest discover -v -s src
